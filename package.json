{
  "name": "integration-example-aws",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "core-app-1",
    "siebel",
    "integration-layer/lambda-soap-processor",
    "integration-layer/lambda-event-publisher",
    "integration-layer/pubsub-subscriber",
    "integration-layer/soap-client"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run tests/integration && vitest run tests/e2e",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "dev:core-app-1": "npm run dev --workspace=core-app-1",
    "dev:siebel": "npm run dev --workspace=siebel",
    "dev:siebel-send": "npm run send --workspace=siebel",
    "dev:siebel-listen": "npm run listen --workspace=siebel",
    "dev:soap-processor": "npm run dev --workspace=integration-layer/lambda-soap-processor",
    "dev:event-publisher": "npm run dev --workspace=integration-layer/lambda-event-publisher",
    "dev:subscriber": "npm run dev --workspace=integration-layer/pubsub-subscriber",
    "test:client": "npm run dev --workspace=integration-layer/soap-client"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "ioredis": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
