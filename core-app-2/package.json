{
  "name": "core-app-2",
  "version": "1.0.0",
  "description": "Core App 2 – Work Order Request Creator (Vue.js + Express)",
  "private": true,
  "scripts": {
    "dev:client": "vite --port 5174",
    "dev:server": "ts-node server/index.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
