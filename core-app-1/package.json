{
  "name": "core-app-1",
  "version": "1.0.0",
  "description": "Core App 1 – Planned Outage Notifier + Work Order Approval Workflow",
  "main": "dist/index.js",
  "scripts": {
    "build:server": "tsc",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:client": "vite --port 5173",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:client\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "fast-xml-parser": "^5.2.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.0",
    "ts-node": "^10.9.0",
    "vite": "^6.3.5"
  }
}
